# Cache rules for the static files (read by Cloudflare; copied into out/ by the build).
# Next.js file names with a hash never change, so they can be kept for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Pictures, sprites, maps and fonts: a day, so a patch that replaces a file under the same name shows within a day.
/assets/images/*
  Cache-Control: public, max-age=86400
/assets/sprite_data/*
  Cache-Control: public, max-age=86400
/assets/map/*
  Cache-Control: public, max-age=86400
/font/*
  Cache-Control: public, max-age=604800
/sprite/*
  Cache-Control: public, max-age=86400
# /assets/json/* is left on the default (always check), because those files change with every patch.
