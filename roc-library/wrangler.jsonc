{
  // Cloudflare Worker for ROC Library: serves the static export in ./out and runs worker/index.ts for /api/*.
  "name": "roc-library",
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only these paths run the Worker (and count as Worker requests); everything else is a free static file.
    "run_worker_first": ["/api/*"]
  }
}
